PORT=3000

# ── SUPABASE CONNECTION POOLER (Para consultas de la aplicación) ──
# Usa el puerto 6543 y el parámetro ?pgbouncer=true (Transaction Mode)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── SUPABASE DIRECT CONNECTION (Para migraciones y CLI de Prisma) ──
# Conexión directa a PostgreSQL en el puerto 5432 (Session Mode)
DIRECT_URL="postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
